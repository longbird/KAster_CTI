// 공유규칙 → 상담원 매트릭스
model shareRuleAgents {
  shareRuleAgentId String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  shareRuleId      String   @db.Uuid
  agentId          String   @db.Uuid
  priority         Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  tenant           tenants    @relation(fields: [tenantId], references: [tenantId])
  shareRule        shareRules @relation(fields: [shareRuleId], references: [shareRuleId], onDelete: Cascade)
  agent            agents     @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@unique([tenantId, shareRuleId, agentId])
  @@index([shareRuleId, priority])
}

// 공유규칙 → 상담원 그룹 매트릭스
model shareRuleAgentGroups {
