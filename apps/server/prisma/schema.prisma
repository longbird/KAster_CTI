// 공유규칙 마스터 (BlueSky ShareRule)
model shareRules {
  shareRuleId  String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  ruleCode     String   @db.VarChar(32)
  ruleName     String   @db.VarChar(128)
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedById  String?  @db.Uuid

  tenant            tenants               @relation(fields: [tenantId], references: [tenantId])
  agents            shareRuleAgents[]
  agentGroups       shareRuleAgentGroups[]
  branches          shareRuleBranches[]
  customers         customers[]           @relation("customer_share_rule")
  defaultForBranches branches[]           @relation("branch_default_share_rule")

  @@unique([tenantId, ruleCode])
  @@index([tenantId, isActive])
