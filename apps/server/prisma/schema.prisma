model tenantSystemSettings {
  tenantSystemSettingId  String   @id @default(uuid()) @db.Uuid
  tenantId               String   @db.Uuid
  recordingEnabled       Boolean  @default(true)
  defaultMaxWaitSeconds  Int      @default(45)
  allowDirectSipDial     Boolean  @default(false)
  defaultSipPassword     String?  @db.Text
  allowedOutboundCallerIds String? @db.Text
  defaultOutboundCallerId String? @db.VarChar(32)
  sipRegisterPort        Int      @default(36070)
  timezone               String   @default("Asia/Seoul") @db.VarChar(64)
  dateFormat             String   @default("YYYY-MM-DD HH:mm:ss") @db.VarChar(32)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  tenant                 tenants  @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

