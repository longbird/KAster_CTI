# ------- 기본 HTTP -------
PORT=3000

# ------- PostgreSQL -------
DATABASE_URL=postgresql://kaster:kaster@localhost:5432/kaster_cti?schema=public

# ------- JWT / Auth -------
# 운영 배포 전 반드시 긴 랜덤 문자열로 교체
JWT_SECRET=change_me

# ------- Redis (리더 선출 + dedupe + Pub/Sub backplane) -------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------- Asterisk AMI -------
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=cti_middleware
AMI_SECRET=STRONG_AMI_PASSWORD
AMI_RECONNECT_MS=5000

# 멀티 Asterisk 노드 구성 시 이 값을 노드별로 고유하게. fingerprint dedupe 의 입력.
ASTERISK_NODE_ID=default

# CallsService.originate 가 AMI Originate Action 에 쓰는 Dialplan context 이름.
# infra/asterisk/extensions_agent.conf 의 outbound-main 에 대응.
ASTERISK_OUTBOUND_CONTEXT=outbound-main

# ------- Seed -------
# prisma/seed.ts 가 bcrypt 로 해싱해 agent1001 / supervisor1 에 공통 적용
SEED_DEMO_PASSWORD=Password123!

# ------- WebSocket -------
# RealtimeGateway CORS 허용 origin. 쉼표 구분 리스트 또는 * (개발용)
WS_CORS_ORIGIN=*
