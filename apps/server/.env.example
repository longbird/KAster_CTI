# ------- 기본 HTTP -------
PORT=3000

# ------- PostgreSQL -------
DATABASE_URL=postgresql://kaster:kaster@localhost:5432/kaster_cti?schema=public

# ------- JWT / Auth -------
# 운영 배포 전 반드시 긴 랜덤 문자열로 교체
JWT_SECRET=change_me

# ------- Redis (리더 선출 + dedupe + Pub/Sub backplane) -------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------- Asterisk AMI -------
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=cti_middleware
AMI_SECRET=STRONG_AMI_PASSWORD
AMI_RECONNECT_MS=5000

# 멀티 Asterisk 노드 구성 시 이 값을 노드별로 고유하게. fingerprint dedupe 의 입력.
ASTERISK_NODE_ID=default

# CallsService.originate 가 AMI Originate Action 에 쓰는 Dialplan context 이름.
# infra/asterisk/extensions_agent.conf 의 outbound-main 에 대응.
ASTERISK_OUTBOUND_CONTEXT=outbound-main

# Attended transfer 완료 시 features.conf 의 atxfercomplete 에 대응하는 기능 코드.
# Asterisk 기본값은 *2.
ASTERISK_ATXFER_COMPLETE_CODE=*2

# Hold/Resume 은 표준 AMI 액션이 아니라 운영 환경별 feature code 로만 opt-in 지원.
# 값을 비워두면 UI/API 모두 비활성화된다.
ASTERISK_HOLD_FEATURE_CODE=
ASTERISK_RESUME_FEATURE_CODE=

# ------- Seed -------
# prisma/seed.ts 가 bcrypt 로 해싱해 agent1001 / supervisor1 에 공통 적용
SEED_DEMO_PASSWORD=Password123!

# ------- CORS -------
# REST CORS 허용 origin. 쉼표 구분 리스트 또는 * (개발용). 운영에서는 반드시 좁힐 것.
REST_CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# RealtimeGateway (WebSocket) CORS 허용 origin. 쉼표 구분 또는 * (개발용)
WS_CORS_ORIGIN=*

# ------- Softphone / WebRTC -------
SOFTPHONE_ENABLED=false
SOFTPHONE_SIP_DOMAIN=
SOFTPHONE_WS_SERVER=
SOFTPHONE_ICE_SERVERS_JSON=[]

# ------- Asterisk Config -------
ASTERISK_CONF_DIR=/etc/asterisk
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/custom

# ------- Internal Runtime Hooks -------
# Asterisk System() hooks call back into NestJS with this secret.
KASTER_INTERNAL_SECRET=change_me_internal

# Smart ARS SEND_SMS action delivery webhook. If unset, SEND_SMS fails and the
# Smart ARS failure prompt is played.
SMART_ARS_SMS_WEBHOOK_URL=
SMART_ARS_SMS_WEBHOOK_SECRET=
