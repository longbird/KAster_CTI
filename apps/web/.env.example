# CTI Middleware REST base URL. NestJS 서버의 global prefix 까지 포함.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# WebSocket 서버 origin. /ws namespace 는 socket.io-client 가 붙인다.
VITE_WS_URL=http://localhost:3000

# Mock 모드 토글. true 면 src/api/mockApi 와 src/mock/mockSocket 이 사용된다.
# 백엔드 없이 화면 확인할 때 유용.
VITE_USE_MOCK=false
