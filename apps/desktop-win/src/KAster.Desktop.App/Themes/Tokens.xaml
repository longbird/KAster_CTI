<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        A안 정제판 토큰. 출처는 기존 앱의 apps/desktop/src/renderer/src/styles.css 다.
        화면 XAML 에는 색상 리터럴을 쓰지 않는다 — 전부 여기를 참조한다.
    -->

    <FontFamily x:Key="FontUi">Segoe UI, Malgun Gothic</FontFamily>

    <!-- 면 -->
    <SolidColorBrush x:Key="BrushBackground" Color="#eef3f7" />
    <SolidColorBrush x:Key="BrushSurface" Color="#ffffff" />
    <SolidColorBrush x:Key="BrushSurfaceMuted" Color="#f6f8fa" />

    <!-- 선 -->
    <SolidColorBrush x:Key="BrushBorder" Color="#cbd5df" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#9ba8b6" />

    <!-- 글자 -->
    <SolidColorBrush x:Key="BrushText" Color="#17202a" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#64748b" />
    <SolidColorBrush x:Key="BrushTextOnAccent" Color="#ffffff" />

    <!-- 주색 -->
    <SolidColorBrush x:Key="BrushAccent" Color="#216e9f" />
    <SolidColorBrush x:Key="BrushAccentStrong" Color="#14557d" />

    <!-- 상태 -->
    <SolidColorBrush x:Key="BrushDanger" Color="#ba2f36" />
    <SolidColorBrush x:Key="BrushSuccess" Color="#1f7a4c" />
    <SolidColorBrush x:Key="BrushWarning" Color="#a16207" />

    <!-- 반경 -->
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusChip">999</CornerRadius>

    <!-- 간격 -->
    <Thickness x:Key="PadPanel">16</Thickness>
    <Thickness x:Key="PadControl">10,8</Thickness>
    <Thickness x:Key="GapStack">0,0,0,12</Thickness>

    <!-- 글자 크기 -->
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeNumber">28</sys:Double>

    <DropShadowEffect x:Key="ShadowPanel"
                      BlurRadius="28"
                      ShadowDepth="10"
                      Direction="270"
                      Color="#0f172a"
                      Opacity="0.14" />

    <!-- 공통 스타일 -->

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <!-- 가변 텍스트는 한 줄 고정 + 말줄임. 줄바꿈으로 아래 요소를 밀어내면 창이 스크롤된다. -->
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    </Style>

    <Style x:Key="TextTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FieldInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Background" Value="{StaticResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource PadControl}" />
        <Setter Property="Height" Value="34" />
    </Style>

    <!--
        읽기 전용 값. 테두리 없이 글자만 보이되 TextBox 라서 끌어서 복사할 수 있다 —
        전화기 설정 화면에 옮겨 적어야 하는 값이라 선택이 되어야 한다.
        고정폭 글꼴이라 주소와 자릿수를 잘못 읽지 않는다.
    -->
    <Style x:Key="FieldReadOnly" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas, Malgun Gothic" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    </Style>

    <Style x:Key="FieldPassword" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Background" Value="{StaticResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource PadControl}" />
        <Setter Property="Height" Value="34" />
    </Style>

    <Style x:Key="ButtonPrimary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextOnAccent}" />
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource BrushAccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource BrushBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
        <Setter Property="Background" Value="{StaticResource BrushDanger}" />
    </Style>

    <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceMuted}" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>

</ResourceDictionary>
