<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        A안 정제판 토큰. 출처는 기존 앱의 apps/desktop/src/renderer/src/styles.css 다.
        화면 XAML 에는 색상 리터럴을 쓰지 않는다 — 전부 여기를 참조한다.
    -->

    <FontFamily x:Key="FontUi">Segoe UI, Malgun Gothic</FontFamily>

    <!-- 면 -->

    <!-- 선 -->

    <!-- 주색 -->

    <!-- 반경 -->
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusChip">999</CornerRadius>

    <!-- 간격 -->
    <Thickness x:Key="PadPanel">16</Thickness>
    <Thickness x:Key="PadControl">10,8</Thickness>
    <Thickness x:Key="GapStack">0,0,0,12</Thickness>

    <!-- 글자 크기 -->
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeNumber">28</sys:Double>

    <DropShadowEffect x:Key="ShadowPanel"
                      BlurRadius="28"
                      ShadowDepth="10"
                      Direction="270"
                      Color="#0f172a"
                      Opacity="0.14" />

    <!-- 공통 스타일 -->

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        <!-- 가변 텍스트는 한 줄 고정 + 말줄임. 줄바꿈으로 아래 요소를 밀어내면 창이 스크롤된다. -->
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
    </Style>

    <Style x:Key="TextTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FieldInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource PadControl}" />
        <Setter Property="Height" Value="34" />
    </Style>

    <!--
        읽기 전용 값. 테두리 없이 글자만 보이되 TextBox 라서 끌어서 복사할 수 있다 —
        전화기 설정 화면에 옮겨 적어야 하는 값이라 선택이 되어야 한다.
        고정폭 글꼴이라 주소와 자릿수를 잘못 읽지 않는다.
    -->
    <Style x:Key="FieldReadOnly" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas, Malgun Gothic" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    </Style>

    <Style x:Key="FieldPassword" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource PadControl}" />
        <Setter Property="Height" Value="34" />
    </Style>

    <Style x:Key="ButtonPrimary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}" />
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <!--
                            버튼이 지정한 정렬을 따른다. 여기서 Center 로 못박아 두면
                            목록 줄처럼 내용을 좌우로 벌려야 하는 버튼에서 글자가 가운데로
                            몰리고, 버튼 쪽에서 무엇을 지정해도 바뀌지 않는다.
                            기본값은 그대로 가운데다 (ButtonPrimary 가 Center 로 둔다).
                        -->
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource BrushAccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource BrushBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        구역 탭. 설정 항목이 늘어도 창에 스크롤을 만들지 않기 위한 것이다 —
        항목을 한 줄로 이어 붙이면 창이 세로로 자라고, 그러면 스크롤이 생긴다.
    -->
    <Style x:Key="TabStrip" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,12,0,0" />
    </Style>

    <Style x:Key="TabHeader" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab"
                            Padding="12,7"
                            Margin="0,0,2,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="0,0,0,2">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
        <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
    </Style>

    <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceMuted}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
    </Style>

    <!--
        아이콘. 16 단위계로 그려 두고 화면에서 그대로 쓴다 — 늘리면 획 굵기가 같이 늘어
        16px 자리에서 뭉갠다. 선으로 그리므로 색은 쓰는 쪽이 정한다.
    -->
    <Geometry x:Key="IconAgents">M2.6,13.4 v-1 a2.6,2.6 0 0 1 2.6,-2.6 h1.6 a2.6,2.6 0 0 1 2.6,2.6 v1 M3.9,5.6 a2.2,2.2 0 1 0 4.4,0 a2.2,2.2 0 1 0 -4.4,0 M13.4,13.4 v-1 a2.6,2.6 0 0 0 -1.9,-2.5</Geometry>
    <Geometry x:Key="IconQueue">M2.5,4.5 h11 M2.5,8 h7 M2.5,11.5 h9</Geometry>
    <Geometry x:Key="IconBell">M8,2.6 a3.4,3.4 0 0 0 -3.4,3.4 v2.3 L3.6,9.9 h8.8 L11.4,8.3 V6 A3.4,3.4 0 0 0 8,2.6 Z M6.6,11.9 a1.4,1.4 0 0 0 2.8,0</Geometry>

    <!--
        머리말 막대의 아이콘 단추. 16px 그림 하나에 32px 누를 자리를 준다 —
        그림 크기대로 두면 못 누른다.
    -->
    <Style x:Key="BarIconButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        기본 컨트롤.

        WPF 의 CheckBox·ComboBox·ScrollBar 는 <b>창의 글자색을 상속받지 않고</b> 시스템 기본
        (검정 글자·흰 바탕)을 쓴다. 어두운 테마에서 그 자리만 하얗게 남는다.

        키를 안 붙여 앱 전체에 걸리게 한다 — 화면마다 지정하게 두면 새 화면에서 반드시 빠뜨린다.
    -->

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- 글자가 길면 줄바꿈해야 한다. 창 너비가 고정이라 밀려나면 잘린다. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Box"
                                Grid.Column="0"
                                Width="16" Height="16"
                                Margin="0,1,8,0"
                                VerticalAlignment="Top"
                                CornerRadius="3"
                                Background="{DynamicResource BrushSurfaceRaised}"
                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                BorderThickness="1">
                            <Path x:Name="Check"
                                  Data="M2.5,6 L5.5,9 L10.5,3.5"
                                  Stroke="{DynamicResource BrushTextOnAccent}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>

                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                            <!--
                                줄바꿈은 이 자리에서만 건다. 앱 전체에 TextBlock 스타일을 걸면
                                버튼 글자까지 잡혀 강조색 위의 글자가 본문 색으로 바뀐다.
                            -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushSurfaceMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Face"
                                            Background="{DynamicResource BrushSurfaceRaised}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusControl}">
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              Data="M0,0 L4.5,4.5 L9,0"
                                              Stroke="{DynamicResource BrushTextMuted}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Margin="10,0,32,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <!-- 펼친 목록도 우리 색이어야 한다. 여기를 안 그리면 흰 목록이 튀어나온다. -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        스크롤 막대. 창은 스크롤되지 않지만 목록과 설정 내용은 자체 스크롤하므로 반드시 보인다.
        기본 막대는 밝은 회색이라 어두운 화면에서 그 줄만 뜬다.
    -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Grip"
                                                    Margin="2,0"
                                                    CornerRadius="999"
                                                    Background="{DynamicResource BrushBorderStrong}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Grip" Property="Background" Value="{DynamicResource BrushTextMuted}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>

                            <!-- 위아래 화살표 단추는 두지 않는다. 8px 폭에 넣으면 누를 수 없는 점이 된다. -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="8" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
