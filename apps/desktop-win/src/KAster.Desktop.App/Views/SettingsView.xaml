<UserControl x:Class="KAster.Desktop.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="ErrorLine" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <!--
        창에 스크롤을 만들지 않는다. 항목이 늘어난 만큼 구역을 탭으로 나눴고,
        세로로 남는 공간은 탭 내용 한 곳만 흡수한다.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="설정" Style="{StaticResource TextTitle}" Margin="0,0,0,8" />

        <TabControl Grid.Row="1" Style="{StaticResource TabStrip}">

            <!-- 서버 -->
            <TabItem Header="서버" Style="{StaticResource TabHeader}">
                <Border Padding="{StaticResource PadPanel}"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}">
                    <StackPanel>
                        <TextBlock Text="서버 주소" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource FieldInput}"
                                 Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <!--
                            안내와 오류가 한 자리를 나눠 쓴다. 높이를 고정해 두면 메시지가 떴다 사라질 때
                            아래 항목들이 흔들리지 않는다.
                        -->
                        <TextBlock Height="34" Margin="0,4,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                    <Setter Property="Text" Value="" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServerUrlChanged}" Value="True">
                                            <Setter Property="Text" Value="바뀐 주소는 다시 로그인할 때부터 쓰입니다" />
                                            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding ServerUrlError}" Style="{StaticResource ErrorLine}" Margin="0" />

                        <!--
                            웹에서 "데스크톱으로 열기" 를 눌러도 이 등록이 풀려 있으면 아무 일이 없다.
                            그때 상담원이 볼 수 있는 자리가 여기뿐이다.
                        -->
                        <TextBlock Text="웹 연동" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                        <TextBlock Text="{Binding ProtocolStatusText}"
                                   Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <Button Content="링크 다시 등록"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding RepairProtocolCommand}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 오디오: 실기기 모드에는 우리 오디오가 없다 -->
            <TabItem Header="오디오">
                <TabItem.Style>
                    <Style TargetType="TabItem" BasedOn="{StaticResource TabHeader}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsAudioDevices}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>
                <Border Padding="{StaticResource PadPanel}"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}">
                    <StackPanel>
                        <TextBlock Text="마이크" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding CaptureDevices}"
                                  SelectedItem="{Binding SelectedCapture}"
                                  Padding="{StaticResource PadControl}"
                                  FontFamily="{StaticResource FontUi}"
                                  FontSize="{StaticResource FontSizeBody}" />

                        <TextBlock Text="통화 소리" Style="{StaticResource SectionLabel}" />
                        <ComboBox ItemsSource="{Binding CallRenderDevices}"
                                  SelectedItem="{Binding SelectedCallRender}"
                                  Padding="{StaticResource PadControl}"
                                  FontFamily="{StaticResource FontUi}"
                                  FontSize="{StaticResource FontSizeBody}" />

                        <TextBlock Text="벨소리" Style="{StaticResource SectionLabel}" />
                        <ComboBox ItemsSource="{Binding RingRenderDevices}"
                                  SelectedItem="{Binding SelectedRingRender}"
                                  Padding="{StaticResource PadControl}"
                                  FontFamily="{StaticResource FontUi}"
                                  FontSize="{StaticResource FontSizeBody}" />

                        <TextBlock Text="바꾼 장치는 다음 통화부터 쓰입니다"
                                   Style="{StaticResource TextCaption}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 핫키 -->
            <TabItem Header="핫키">
                <TabItem.Style>
                    <Style TargetType="TabItem" BasedOn="{StaticResource TabHeader}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsHotkeys}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>
                <Border Padding="{StaticResource PadPanel}"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Text="창이 뒤에 있어도 먹는 키입니다. Ctrl·Shift·Alt 중 하나를 반드시 넣으세요. 예) Ctrl+Shift+F9" />

                        <TextBlock Text="받기" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource FieldInput}"
                                 Text="{Binding AnswerHotkey, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="끊기" Style="{StaticResource SectionLabel}" />
                        <TextBox Style="{StaticResource FieldInput}"
                                 Text="{Binding HangupHotkey, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="마이크" Style="{StaticResource SectionLabel}" />
                        <TextBox Style="{StaticResource FieldInput}"
                                 Text="{Binding MuteHotkey, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="비워 두면 그 동작에는 핫키를 쓰지 않습니다"
                                   Style="{StaticResource TextCaption}"
                                   Margin="0,8,0,0" />

                        <TextBlock Text="{Binding HotkeyError}" Style="{StaticResource ErrorLine}" />

                        <!-- 다른 프로그램이 먼저 잡은 조합은 눌러도 아무 일이 없다. 그 자리에서 알린다. -->
                        <TextBlock Text="{Binding HotkeyNotice}"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource BrushWarning}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 전환 -->
            <TabItem Header="전환">
                <TabItem.Style>
                    <Style TargetType="TabItem" BasedOn="{StaticResource TabHeader}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsTransferHotkeys}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>

                <Border Padding="{StaticResource PadPanel}"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Text="통화 중에 숫자 키를 누르면 여기 적어 둔 자리로 넘깁니다. 번호를 적고 있는 칸에서는 먹지 않습니다. 빈 칸은 걸지 않습니다." />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="이름" Style="{StaticResource TextCaption}" />
                            <TextBlock Grid.Column="2" Text="대상" Style="{StaticResource TextCaption}" Margin="6,0,0,0" />
                            <TextBlock Grid.Column="3" Text="협의" Style="{StaticResource TextCaption}" Margin="6,0,0,0" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TransferHotkeys.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Slot}"
                                                   Style="{StaticResource TextBody}"
                                                   VerticalAlignment="Center" />

                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource FieldInput}"
                                                 Margin="0"
                                                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox Grid.Column="2"
                                                 Style="{StaticResource FieldInput}"
                                                 Margin="6,0,0,0"
                                                 Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Column="3"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsAttended}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="협의를 끄면 상대와 통화하지 않고 바로 넘깁니다"
                                   Style="{StaticResource TextCaption}"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="{Binding TransferHotkeys.Error}" Style="{StaticResource ErrorLine}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 통화 -->
            <TabItem Header="통화">
                <TabItem.Style>
                    <Style TargetType="TabItem" BasedOn="{StaticResource TabHeader}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsCallPreferences}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>
                <Border Padding="{StaticResource PadPanel}"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}">
                    <StackPanel>
                        <TextBlock Text="자동응답 대기 (초)" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource FieldInput}"
                                 Text="{Binding SelfAnswerSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="걸기를 누른 뒤 이 시간 안에 걸려 오는 전화를 내가 건 것으로 보고 자동으로 받습니다. 길게 잡으면 그 사이 걸려 온 고객 전화까지 받습니다." />

                        <TextBlock Text="PBX 응답 대기 (초)" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                        <TextBox Style="{StaticResource FieldInput}"
                                 Text="{Binding PbxWaitSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="보류·협의 전환을 요청한 뒤 PBX 의 응답을 기다리는 시간입니다. 짧게 잡으면 멀쩡히 걸린 보류에도 응답이 없다고 뜹니다." />

                        <TextBlock Text="자동 받기 (초)" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                        <TextBox Style="{StaticResource FieldInput}"
                                 Text="{Binding AutoAnswerSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="0 이면 쓰지 않습니다. 걸려 온 전화가 이 시간 동안 울리면 자동으로 받습니다. 수락/거절을 묻는 화면에는 걸리지 않습니다." />

                        <TextBlock Text="자동 끊기 (초)" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                        <TextBox Style="{StaticResource FieldInput}"
                                 Text="{Binding AutoRejectSeconds, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="후처리 뒤 자동 대기 (초)" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                        <TextBox Style="{StaticResource FieldInput}"
                                 Text="{Binding AutoAvailableSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="0 이면 쓰지 않습니다. 통화가 끝난 뒤 이 시간이 지나면 스스로 대기 상태로 돌아갑니다." />

                        <TextBlock Text="{Binding CallSettingsError}" Style="{StaticResource ErrorLine}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 앱: 버전 · 업데이트 · 문제 기록 -->
            <!-- 일반 -->
            <TabItem Header="일반">
                <TabItem.Style>
                    <Style TargetType="TabItem" BasedOn="{StaticResource TabHeader}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsGeneral}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>

                <Border Padding="{StaticResource PadPanel}"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}">
                    <StackPanel>
                        <TextBlock Text="색 테마" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding Theme}"
                                  Padding="{StaticResource PadControl}"
                                  FontFamily="{StaticResource FontUi}"
                                  FontSize="{StaticResource FontSizeBody}" />
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,16"
                                   Text="시스템을 따르면 윈도우의 밝게/어둡게 설정을 그대로 씁니다. 어두운 상담실에서는 어둡게가 눈이 덜 부십니다." />

                        <CheckBox Content="윈도우에 로그인하면 함께 시작" IsChecked="{Binding AutoStart}" />
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="자리를 나눠 쓰는 PC 라면 자리마다 따로 등록됩니다." />

                        <CheckBox Content="다른 창 위에 늘 보이기"
                                  IsChecked="{Binding AlwaysOnTop}"
                                  Margin="0,14,0,0" />

                        <CheckBox Content="닫기를 누르면 트레이로 내리기"
                                  IsChecked="{Binding CloseToTray}"
                                  Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="트레이로 내려가면 자리비움으로 바뀌어 전화가 배정되지 않습니다. 통화 중이면 통화가 끝난 뒤에 바뀝니다. 앱을 아주 끄려면 트레이 아이콘에서 종료를 누르세요." />

                        <TextBlock Text="벨소리" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                        <ComboBox ItemsSource="{Binding RingTones}"
                                  SelectedItem="{Binding RingTone}"
                                  Padding="{StaticResource PadControl}" />
                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="전화가 오면 이 소리로 울립니다. 나가는 장치는 오디오 탭의 벨소리 스피커를 따릅니다. 무음으로 두면 화면과 트레이 알림만 남습니다." />

                        <TextBlock Text="{Binding GeneralNotice}"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource BrushWarning}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="앱" Style="{StaticResource TabHeader}">
                <Border Padding="{StaticResource PadPanel}"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}">
                    <StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="버전" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Update.CurrentVersion}"
                                       Style="{StaticResource TextBody}"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="{Binding Update.StatusText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                        <Style.Triggers>
                                            <!-- 필수 업데이트는 눈에 걸려야 한다. 그래도 앱을 끄지는 않는다. -->
                                            <DataTrigger Binding="{Binding Update.IsRequired}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding Update.Notes}"
                                       Style="{StaticResource TextCaption}"
                                       TextWrapping="Wrap"
                                       MaxHeight="60"
                                       Margin="0,6,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="지금 확인"
                                        MinWidth="96"
                                        Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding Update.CheckCommand}" />
                                <Button Content="설치 파일 받기"
                                        Margin="8,0,0,0"
                                        MinWidth="110"
                                        Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding Update.DownloadCommand}" />
                                <!-- 받아 둔 것이 있을 때만 나타난다. 없는데 열면 빈 폴더가 뜬다. -->
                                <Button Content="받은 폴더 열기"
                                        Margin="8,0,0,0"
                                        Command="{Binding Update.OpenDownloadFolderCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Update.HasFile}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource TextCaption}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Text="설치는 상담원이 정합니다. 받은 파일은 통화가 없을 때 실행하세요." />

                            <Border Height="1"
                                    Background="{DynamicResource BrushBorder}"
                                    Margin="0,16,0,0" />
                        </StackPanel>

                        <!--
                            앱이 조용히 멈추면 로그 파일이 유일한 단서다. 상담원에게 %LOCALAPPDATA% 경로를
                            전화로 불러 주는 것은 현장에서 통하지 않는다.
                        -->
                        <TextBlock Text="문제 기록" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                        <Button Content="로그 폴더 열기"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="닫기"
                    Style="{StaticResource ButtonSecondary}"
                    Command="{Binding CloseCommand}" />
            <Button Grid.Column="2" Content="저장"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True" />
        </Grid>
    </Grid>
</UserControl>
