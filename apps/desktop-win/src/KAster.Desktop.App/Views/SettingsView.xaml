<UserControl x:Class="KAster.Desktop.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <!-- 창에 스크롤을 만들지 않는다. 가운데 한 곳만 남는 공간을 흡수한다. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="설정" Style="{StaticResource TextTitle}" Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Padding="{StaticResource PadPanel}"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <StackPanel>
                <TextBlock Text="서버 주소" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                <TextBox Style="{StaticResource FieldInput}"
                         Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                <!--
                    안내와 오류가 한 자리를 나눠 쓴다. 높이를 고정해 두면 메시지가 떴다 사라질 때
                    아래 항목들이 흔들리지 않는다.
                -->
                <TextBlock Height="34" Margin="0,4,0,4" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                            <Setter Property="Text" Value="" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServerUrlChanged}" Value="True">
                                    <Setter Property="Text" Value="바뀐 주소는 다시 로그인할 때부터 쓰입니다" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ServerUrlError}" Value="{x:Null}">
                                    <!-- 오류가 없으면 위 안내를 그대로 둔다 -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding ServerUrlError}"
                           Foreground="{StaticResource BrushDanger}"
                           TextWrapping="Wrap"
                           Style="{StaticResource TextCaption}"
                           Margin="0,0,0,4" />

                <!-- 실기기 모드에는 우리 오디오가 없다. 고를 것을 보여 주면 안 고른 줄 알고 헤맨다. -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsAudioDevices}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="마이크" Style="{StaticResource TextCaption}" Margin="0,4,0,4" />
                    <ComboBox ItemsSource="{Binding CaptureDevices}"
                              SelectedItem="{Binding SelectedCapture}"
                              Padding="{StaticResource PadControl}"
                              FontFamily="{StaticResource FontUi}"
                              FontSize="{StaticResource FontSizeBody}" />

                    <TextBlock Text="통화 소리" Style="{StaticResource TextCaption}" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{Binding CallRenderDevices}"
                              SelectedItem="{Binding SelectedCallRender}"
                              Padding="{StaticResource PadControl}"
                              FontFamily="{StaticResource FontUi}"
                              FontSize="{StaticResource FontSizeBody}" />

                    <TextBlock Text="벨소리" Style="{StaticResource TextCaption}" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{Binding RingRenderDevices}"
                              SelectedItem="{Binding SelectedRingRender}"
                              Padding="{StaticResource PadControl}"
                              FontFamily="{StaticResource FontUi}"
                              FontSize="{StaticResource FontSizeBody}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="닫기"
                    Style="{StaticResource ButtonSecondary}"
                    Command="{Binding CloseCommand}" />
            <Button Grid.Column="2" Content="저장"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True" />
        </Grid>
    </Grid>
</UserControl>
