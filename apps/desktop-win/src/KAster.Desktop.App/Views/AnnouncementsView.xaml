<UserControl x:Class="KAster.Desktop.App.Views.AnnouncementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <!--
        공지. 서버가 대상과 기간을 이미 걸러 고정 공지를 위로 올려 주므로 여기서 다시 정렬하지 않는다.
        창이 스크롤되지 않도록 보여 주는 건수를 고정하고, 가린 건수는 숫자로 알린다.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0" ItemsSource="{Binding Announcements.Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="12,10"
                            Background="{StaticResource BrushSurface}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                <Style.Triggers>
                                    <!-- 안 읽은 것이 어느 것인지 보여야 다시 열 이유가 생긴다. -->
                                    <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding TitleLine}"
                                           Style="{StaticResource TextBody}"
                                           FontWeight="SemiBold" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Meta}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource TextCaption}" />
                            </Grid>

                            <!--
                                본문은 접어서 보이되 줄 수를 묶는다. 긴 공지 하나가 창을 넘기면
                                아래 공지가 통째로 사라진다.
                            -->
                            <TextBlock Text="{Binding Body}"
                                       Margin="0,4,0,0"
                                       MaxHeight="54"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource TextCaption}"
                                       Foreground="{StaticResource BrushText}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 공지가 없다는 것도 알아야 하는 사실이다. 빈 화면은 못 받아 온 것과 구분이 안 된다. -->
        <TextBlock Grid.Row="0"
                   Text="올라온 공지가 없습니다."
                   VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Announcements.HasRows}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 안 보여 준 공지는 읽음 처리도 하지 않는다. 그 사실을 숫자로 알린다. -->
        <TextBlock Grid.Row="1" Margin="0,2,0,0"
                   Text="{Binding Announcements.RowsHiddenText}"
                   Style="{StaticResource TextCaption}" />

        <Button Grid.Row="2" Margin="0,10,0,0" Content="닫기"
                Style="{StaticResource ButtonSecondary}"
                Command="{Binding Announcements.CloseCommand}" />
    </Grid>
</UserControl>
