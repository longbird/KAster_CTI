<UserControl x:Class="KAster.Desktop.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <!--
        창에 스크롤을 만들지 않는다. 행 높이를 고정하고 남는 세로 공간은 마지막 여백 한 곳만 흡수한다.
    -->
    <Border Margin="24" Padding="{StaticResource PadPanel}"
            Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusPanel}"
            VerticalAlignment="Center">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="PBX 상담원" Style="{StaticResource TextTitle}" Margin="0,0,0,20" />

            <TextBlock Grid.Row="2" Text="아이디" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
            <TextBox Grid.Row="3" Margin="{StaticResource GapStack}"
                     Style="{StaticResource FieldInput}"
                     Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Text="비밀번호" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordField" Grid.Row="5" Margin="{StaticResource GapStack}"
                         Style="{StaticResource FieldPassword}"
                         PasswordChanged="OnPasswordChanged" />

            <TextBlock Grid.Row="6" Text="내선" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
            <TextBox Grid.Row="7" Margin="0,0,0,16"
                     Style="{StaticResource FieldInput}"
                     Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="8">
                <!--
                    기본은 실기기 모드다. 대부분의 자리에 책상 전화기가 있고,
                    소프트폰을 잘못 켜면 앱이 전화기와 같은 내선을 두고 다툰다.
                -->
                <CheckBox Content="이 PC 에서 소프트폰으로 통화"
                          Margin="0,0,0,6"
                          IsChecked="{Binding UseSoftphone}"
                          Foreground="{StaticResource BrushText}"
                          FontFamily="{StaticResource FontUi}"
                          FontSize="{StaticResource FontSizeCaption}" />

                <!-- 저장하는 것은 아이디와 내선뿐이다. 비밀번호는 매번 친다. -->
                <CheckBox Content="아이디·내선 저장"
                          Margin="0,0,0,8"
                          IsChecked="{Binding RememberMe}"
                          Foreground="{StaticResource BrushTextMuted}"
                          FontFamily="{StaticResource FontUi}"
                          FontSize="{StaticResource FontSizeCaption}" />

                <!--
                    지난번에 켜 뒀으면 비밀번호를 묻지 않고 그대로 들어간다.
                    저장되는 것은 "그렇게 해도 된다" 는 표시뿐이고, 되살리는 재료는 금고에 이미 있는
                    refresh token 이다 — 비밀번호는 여전히 어디에도 남지 않는다.
                -->
                <CheckBox Content="자동 로그인"
                          Margin="0,0,0,8"
                          IsChecked="{Binding AutoSignIn}"
                          Foreground="{StaticResource BrushTextMuted}"
                          FontFamily="{StaticResource FontUi}"
                          FontSize="{StaticResource FontSizeCaption}" />

                <!--
                    오류 자리를 항상 잡아 두면 메시지가 떴다 사라질 때 아래 버튼이 흔들리지 않는다.
                    되살리는 중이라는 안내도 이 한 자리를 같이 쓴다 — 줄을 새로 만들면 창이 세로로
                    자라고, 이 창은 스크롤이 생기면 안 된다.
                -->
                <Grid Height="34">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource BrushDanger}"
                               Style="{StaticResource TextCaption}"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="이전 로그인으로 접속 중…"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsResuming}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="로그인"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SignInCommand}"
                        IsDefault="True" />

                <!-- 못 붙는 주소면 로그인 자체가 안 된다. 여기서 고칠 수 있어야 한다. -->
                <Button Content="서버 설정"
                        Margin="0,8,0,0"
                        Padding="6,2"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontFamily="{StaticResource FontUi}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
