<UserControl x:Class="KAster.Desktop.App.Views.LoginView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="clr-namespace:KAster.Desktop.App.Controls" Background="{DynamicResource BrushBackground}">
  <Grid Margin="32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="4" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
      <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource BrushBrand}" Margin="0,0,14,0">
        <icons:AppIcon Kind="Headset" Size="32" Foreground="{DynamicResource BrushBrandText}" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="반가워요" Style="{StaticResource TextTitle}" />
        <TextBlock Text="PBX 상담원에 로그인하세요." Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="1">
      <Label Content="아이디" Target="{Binding ElementName=LoginIdField}" Padding="0,0,0,4" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
      <TextBox x:Name="LoginIdField" Style="{StaticResource FieldInput}" Margin="0,0,0,10" AutomationProperties.Name="아이디" Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}" />
      <Label Content="비밀번호" Target="{Binding ElementName=PasswordField}" Padding="0,0,0,4" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
      <PasswordBox x:Name="PasswordField" Style="{StaticResource FieldPassword}" Margin="0,0,0,10" AutomationProperties.Name="비밀번호" PasswordChanged="OnPasswordChanged" />
      <Label Content="내선 번호" Target="{Binding ElementName=ExtensionField}" Padding="0,0,0,4" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
      <TextBox x:Name="ExtensionField" Style="{StaticResource FieldInput}" Margin="0,0,0,12" AutomationProperties.Name="내선 번호" Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <StackPanel Grid.Row="2">
      <WrapPanel Margin="0,0,0,8">
        <CheckBox Content="아이디·내선 저장" IsChecked="{Binding RememberMe}" Margin="0,0,18,0" FontSize="12" />
        <CheckBox Content="자동 로그인" IsChecked="{Binding AutoSignIn}" FontSize="12" />
      </WrapPanel>
      <CheckBox Content="이 PC에서 소프트폰으로 통화" IsChecked="{Binding UseSoftphone}" FontSize="12" />
    </StackPanel>
    <!-- 오류/자동 로그인 안내가 버튼 위치를 움직이지 않도록 자리를 확보한다. -->
    <Grid Grid.Row="3" Height="28" Margin="0,8,0,0">
      <TextBlock Text="{Binding ErrorMessage}" ToolTip="{Binding ErrorMessage}" Foreground="{DynamicResource BrushDanger}" Style="{StaticResource TextCaption}" AutomationProperties.LiveSetting="Assertive" />
      <TextBlock Text="이전 로그인으로 접속 중…">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsResuming}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
    <StackPanel Grid.Row="5">
      <Button Content="로그인" Style="{StaticResource ButtonPrimary}" Command="{Binding SignInCommand}" IsDefault="True" />
      <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource ButtonSecondary}" Background="Transparent" BorderThickness="0" Height="28" Margin="0,8,0,0" HorizontalAlignment="Center" Padding="12,0" FontSize="12">
        <StackPanel Orientation="Horizontal">
          <icons:AppIcon Kind="Settings" Size="14" Margin="0,0,6,0" />
          <TextBlock Text="서버 설정" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>