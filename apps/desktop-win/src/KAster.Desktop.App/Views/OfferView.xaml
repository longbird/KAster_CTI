<UserControl x:Class="KAster.Desktop.App.Views.OfferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <!--
        큐가 넘기기 전에 물어보는 호. 수락해야 전화기가 연결되고, 그 전까지 고객은
        큐에서 대기음을 듣고 있다 — 상담원이 고민하는 동안 고객이 무음을 듣지 않는다.

        읽어야 하는 것은 수신 화면과 같다: 어느 지사로 걸었는가, 그리고 고객 번호.
        모두 한 줄 + 말줄임이라 긴 값이 와도 창이 늘어나지 않는다.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="받으시겠습니까?"
                   Style="{StaticResource TextCaption}"
                   Foreground="{StaticResource BrushAccent}" />

        <Border Grid.Row="1" Margin="0,8,0,12"
                Padding="{StaticResource PadPanel}"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding CalledLine}"
                           Style="{StaticResource TextBody}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" />

                <TextBlock Text="{Binding OfferPhoneNumber}"
                           Style="{StaticResource TextBody}"
                           FontSize="{StaticResource FontSizeNumber}"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" />

                <TextBlock Text="{Binding CustomerName}"
                           Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CustomerName}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="거절"
                    Style="{StaticResource ButtonDanger}"
                    Command="{Binding RejectOfferCommand}" />

            <Button Grid.Column="2" Content="수락"
                    Style="{StaticResource ButtonPrimary}"
                    IsDefault="True"
                    Command="{Binding AcceptOfferCommand}" />
        </Grid>
    </Grid>
</UserControl>
