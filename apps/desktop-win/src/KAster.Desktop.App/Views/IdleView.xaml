<UserControl x:Class="KAster.Desktop.App.Views.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">

    <!--
        창에 스크롤을 만들지 않는다. 세로 공간은 가운데 안내 영역 한 곳만 흡수한다(Height="*").
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            신원 막대. 이름은 하루에 한 번 확인하면 되는 값이라 카드가 아니라 44px 줄로 둔다 —
            그렇게 비운 자리를 하루 종일 보는 것들(근무 상태·대기 목록)이 쓴다.
        -->
        <Border Grid.Row="0" Height="44" Padding="14,0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{Binding AgentName}"
                           Style="{StaticResource TextBody}"
                           FontWeight="SemiBold" />

                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding Extension, Mode=OneWay}"
                           Style="{StaticResource TextCaption}" />

                <!--
                    서버 연결과 전화 등록은 서로 다른 것이다. 하나로 합치면 "연결됨" 인데 전화가
                    한 통도 안 오는 상태를 상담원이 알 길이 없다.

                    막대에는 점만 두고 무슨 뜻인지는 툴팁이 말한다. 44px 안에서 긴 문장은
                    잘리는데, 잘린 문장은 없는 것보다 나쁘다.
                -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource BrushDanger}" />
                                <Setter Property="ToolTip" Value="서버 끊김" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
                                        <Setter Property="ToolTip" Value="서버 연결됨" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="서버" Style="{StaticResource TextCaption}" Margin="5,0,0,0" VerticalAlignment="Center" />

                    <Border Width="1" Height="12" Margin="9,0" VerticalAlignment="Center"
                            Background="{DynamicResource BrushBorder}" />

                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             ToolTip="{Binding DeskPhone.PhoneStatusText}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource BrushDanger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeskPhone.IsPhoneRegistered}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="전화기" Style="{StaticResource TextCaption}" Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding DeskPhone.PhoneStatusText}" />
                </StackPanel>

                <Border Grid.Column="4" Width="1" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                        Background="{DynamicResource BrushBorder}" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BarIconButton}"
                            ToolTip="상담원 목록"
                            Command="{Binding Directory.OpenCommand}">
                        <Path Data="{StaticResource IconAgents}"
                              Stroke="{DynamicResource BrushTextMuted}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>

                    <Button Style="{StaticResource BarIconButton}"
                            ToolTip="큐 현황"
                            Command="{Binding Queues.OpenCommand}">
                        <Path Data="{StaticResource IconQueue}"
                              Stroke="{DynamicResource BrushTextMuted}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>

                    <!-- 안 읽은 공지는 점으로 알린다. 44px 막대에 숫자를 넣을 자리가 없다. -->
                    <Button Style="{StaticResource BarIconButton}"
                            ToolTip="{Binding Announcements.EntryText}"
                            Command="{Binding Announcements.OpenCommand}">
                        <Grid>
                            <Path Data="{StaticResource IconBell}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{DynamicResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Announcements.HasUnread}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <Ellipse Width="6" Height="6"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-1,-1,0"
                                     Fill="{DynamicResource BrushDanger}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Announcements.HasUnread}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            본문: 상태 · 대기 안내 · 발신.
            가운데 안내만 남는 공간을 흡수한다(Height="*"). 위아래는 Auto 라 창을 줄여도 밀리지 않는다.
        -->
        <Border Grid.Row="1" Margin="16,12"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <Grid Margin="{StaticResource PadPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 근무 상태: 자리비움일 때는 큐가 전화를 배정하지 않는다 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        색 레일. 이 창에서 가장 자주 보는 한 줄이라 글자보다 먼저 읽히는 표시를 둔다 —
                        전화를 받는 자리인지 아닌지를 눈을 옮기지 않고 안다.
                    -->
                    <Border Grid.Column="0" Width="3" Margin="0,0,12,0" CornerRadius="999">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TextCaption}" Text="근무 상태" />
                        <TextBlock Margin="0,1,0,0" FontWeight="SemiBold" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                    <Setter Property="Text" Value="자리비움" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                            <Setter Property="Text" Value="대기" />
                                            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2" VerticalAlignment="Center" MinWidth="96"
                            Command="{Binding ToggleAvailabilityCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                <Setter Property="Content" Value="대기로" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                        <Setter Property="Content" Value="자리비움" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 대기 안내 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dial.IsDialing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DeskPhone.ShowsDeskPhoneSetup}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="대기 중" Style="{StaticResource TextTitle}" HorizontalAlignment="Center" />

                    <!--
                        당겨받기. 옆자리에 울리는 전화를 여기서 끌어온다.
                        받을 수 있는 것이 있을 때만 나타난다 — 늘 떠 있으면 빈 목록이 자리만 차지한다.
                    -->
                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Waiting.HasWaitingCalls}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="당겨받을 수 있는 전화"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TextCaption}" />

                            <!--
                                한두 건이면 목록이 읽기 좋고, 쌓이면 타일이 한눈에 들어온다.
                                자리마다 선호가 달라 고르게 둔다.
                            -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="목록"
                                        Padding="6,1" BorderThickness="0" Cursor="Hand"
                                        Background="Transparent"
                                        FontFamily="{StaticResource FontUi}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Command="{Binding Waiting.SetWaitingLayoutCommand}"
                                        CommandParameter="list">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Waiting.ShowsWaitingAsList}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="타일"
                                        Padding="6,1" BorderThickness="0" Cursor="Hand"
                                        Background="Transparent"
                                        FontFamily="{StaticResource FontUi}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Command="{Binding Waiting.SetWaitingLayoutCommand}"
                                        CommandParameter="tile">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Waiting.ShowsWaitingAsTile}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 목록: 한 줄에 하나. 고객명과 큐를 함께 읽는다. -->
                        <ItemsControl ItemsSource="{Binding Waiting.WaitingCalls}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Waiting.ShowsWaitingAsList}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,4"
                                            HorizontalContentAlignment="Left"
                                            Style="{StaticResource ButtonSecondary}"
                                            Command="{Binding DataContext.Waiting.PickupCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource BrushTextMuted}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 타일: 한 줄에 둘. 번호 위주로 여러 건을 한눈에 본다. -->
                        <ItemsControl ItemsSource="{Binding Waiting.WaitingCalls}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Waiting.ShowsWaitingAsTile}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,4,4"
                                            HorizontalContentAlignment="Center"
                                            Style="{StaticResource ButtonSecondary}"
                                            Command="{Binding DataContext.Waiting.PickupCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding PhoneNumber}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 자리에 못 들어간 건수는 숨기지 않고 숫자로 알린다. -->
                        <TextBlock Text="{Binding Waiting.WaitingCallsHiddenText}"
                                   Style="{StaticResource TextCaption}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!--
                    실기기 등록 안내. 전화기가 등록돼 있지 않으면 전화를 한 통도 못 받으므로,
                    그 자리에서 필요한 것은 "대기 중" 안내가 아니라 전화기에 넣을 값이다.
                    값은 읽기 전용 TextBox 라 상담원이 끌어서 복사할 수 있다.
                -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeskPhone.ShowsDeskPhoneSetup}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="전화기에 아래 값을 넣으세요"
                               Style="{StaticResource TextBody}"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 스스로도 몇 초마다 확인하지만, 기다리지 않고 바로 보고 싶을 때가 있다. -->
                        <Button Grid.Column="1"
                                Content="다시 확인"
                                Padding="6,0" BorderThickness="0"
                                Background="Transparent" Cursor="Hand"
                                Foreground="{DynamicResource BrushAccent}"
                                FontFamily="{StaticResource FontUi}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Command="{Binding DeskPhone.RecheckDeskPhoneCommand}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="서버" Style="{StaticResource TextCaption}" Margin="0,0,10,5" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeskPhone.SipServerAddress, Mode=OneWay}"
                                 Style="{StaticResource FieldReadOnly}" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="계정" Style="{StaticResource TextCaption}" Margin="0,0,10,5" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeskPhone.SipUsername, Mode=OneWay}"
                                 Style="{StaticResource FieldReadOnly}" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="도메인" Style="{StaticResource TextCaption}" Margin="0,0,10,5" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DeskPhone.SipDomain, Mode=OneWay}"
                                 Style="{StaticResource FieldReadOnly}" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="전송" Style="{StaticResource TextCaption}" Margin="0,0,10,5" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DeskPhone.SipTransport, Mode=OneWay}"
                                 Style="{StaticResource FieldReadOnly}" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="비밀번호" Style="{StaticResource TextCaption}" Margin="0,0,10,0" />
                        <Grid Grid.Row="4" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 자리 화면은 지나가는 사람에게 그대로 보인다. 넣을 때만 펼친다. -->
                            <TextBox Grid.Column="0" Text="{Binding DeskPhone.SipPasswordDisplay, Mode=OneWay}"
                                     Style="{StaticResource FieldReadOnly}" />

                            <Button Grid.Column="1" Padding="6,0" BorderThickness="0"
                                    Background="Transparent" Cursor="Hand"
                                    Foreground="{DynamicResource BrushAccent}"
                                    FontFamily="{StaticResource FontUi}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Command="{Binding DeskPhone.ToggleSipPasswordCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="보기" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeskPhone.IsSipPasswordVisible}" Value="True">
                                                <Setter Property="Content" Value="가리기" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </StackPanel>

                <!--
                    발신 중. PBX 가 이 단말을 먼저 부르는 방식이라 걸고 나서 전화가 올 때까지 시간이 뜬다.
                    그 사이 화면이 "대기 중" 이면 눌린 건지 알 수 없다.
                -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dial.IsDialing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="발신 중"
                               Style="{StaticResource TextTitle}"
                               Foreground="{DynamicResource BrushAccent}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Dial.DialingNumber}"
                               FontFamily="{StaticResource FontUi}"
                               FontSize="{StaticResource FontSizeNumber}"
                               Foreground="{DynamicResource BrushText}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="전화기를 받으면 연결됩니다"
                               Style="{StaticResource TextCaption}"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 발신 -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="전화 걸기" Style="{StaticResource TextCaption}" Margin="0,0,0,6" />

                    <!--
                        발신번호는 외부로 걸 때만 뜻이 있다. 내선 통화에는 쓰이지 않으므로 접어 둔다.
                        Collapsed 라 자리도 차지하지 않아 창 높이가 흔들리지 않는다.
                    -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dial.ShowsCallerIdPicker}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="발신번호" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Dial.CallerIds}"
                                  SelectedItem="{Binding Dial.SelectedCallerId}"
                                  Padding="{StaticResource PadControl}"
                                  FontFamily="{StaticResource FontUi}"
                                  FontSize="{StaticResource FontSizeBody}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- UpdateSourceTrigger=PropertyChanged 라야 한 글자 칠 때마다 버튼이 열린다 -->
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource FieldInput}"
                                 Text="{Binding Dial.DialNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="80"
                                Content="걸기"
                                Style="{StaticResource ButtonPrimary}"
                                IsDefault="True"
                                Command="{Binding Dial.DialCommand}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 꼬리말: 알림 자리를 고정해 두면 메시지가 떠도 위 영역이 흔들리지 않는다 -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Height="20"
                       Text="{Binding NoticeMessage}"
                       Foreground="{DynamicResource BrushWarning}"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource TextCaption}" />

            <!--
                새 버전이 있을 때만 나타난다. 알림 자리(NoticeMessage)는 통화 알림이 지나가면
                덮이므로, 남아 있어야 하는 것은 이 자리가 든다. 누르면 설정의 앱 탭으로 간다.
                이 행의 높이는 옆 버튼들이 이미 정하고 있어 창이 커지지 않는다.
            -->
            <Button Grid.Column="1"
                    Content="업데이트 있음"
                    Padding="8,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontFamily="{StaticResource FontUi}"
                    FontSize="{StaticResource FontSizeCaption}"
                    FontWeight="SemiBold"
                    Command="{Binding OpenSettingsCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Update.HasUpdate}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- 필수는 눈에 더 걸려야 한다. 그래도 앱을 끄지는 않는다. -->
                            <DataTrigger Binding="{Binding Update.IsRequired}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 못 받은 전화를 다시 걸려면 지난 통화를 볼 수 있어야 한다. -->
            <Button Grid.Column="2"
                    Content="지난 통화"
                    Padding="8,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Foreground="{DynamicResource BrushTextMuted}"
                    FontFamily="{StaticResource FontUi}"
                    FontSize="{StaticResource FontSizeCaption}"
                    Command="{Binding History.OpenHistoryCommand}" />

            <!-- 교대 근무에서 앞사람 계정으로 앉지 않으려면 나가는 길이 있어야 한다. -->
            <Button Grid.Column="3"
                    Content="설정"
                    Padding="8,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Foreground="{DynamicResource BrushTextMuted}"
                    FontFamily="{StaticResource FontUi}"
                    FontSize="{StaticResource FontSizeCaption}"
                    Command="{Binding OpenSettingsCommand}" />

            <Button Grid.Column="4"
                    Content="로그아웃"
                    Padding="8,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Foreground="{DynamicResource BrushTextMuted}"
                    FontFamily="{StaticResource FontUi}"
                    FontSize="{StaticResource FontSizeCaption}"
                    Command="{Binding SignOutCommand}" />
        </Grid>
    </Grid>
</UserControl>
