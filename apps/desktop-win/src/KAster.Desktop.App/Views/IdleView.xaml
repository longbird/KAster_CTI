<UserControl x:Class="KAster.Desktop.App.Views.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <!--
        창에 스크롤을 만들지 않는다. 세로 공간은 가운데 안내 영역 한 곳만 흡수한다(Height="*").
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 머리말: 상담원과 연결 상태 -->
        <Border Grid.Row="0" Padding="{StaticResource PadPanel}"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding AgentName}" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0">
                        <Run Text="내선 " /><Run Text="{Binding Extension, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!--
                    서버 연결과 전화 등록은 서로 다른 것이다. 하나로 합치면
                    "연결됨" 인데 전화가 한 통도 안 오는 상태를 상담원이 알 길이 없다.
                -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Padding="10,4"
                            CornerRadius="{StaticResource RadiusChip}"
                            HorizontalAlignment="Right"
                            Background="{StaticResource BrushSurfaceMuted}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                    <Setter Property="Text" Value="서버 끊김" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="서버 연결됨" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Border Padding="10,4" Margin="0,4,0,0"
                            CornerRadius="{StaticResource RadiusChip}"
                            HorizontalAlignment="Right"
                            Background="{StaticResource BrushSurfaceMuted}">
                        <TextBlock Text="{Binding PhoneStatusText}"
                                   TextWrapping="Wrap"
                                   MaxWidth="230">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPhoneRegistered}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            본문: 상태 · 대기 안내 · 발신.
            가운데 안내만 남는 공간을 흡수한다(Height="*"). 위아래는 Auto 라 창을 줄여도 밀리지 않는다.
        -->
        <Border Grid.Row="1" Margin="0,12"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <Grid Margin="{StaticResource PadPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 근무 상태: 이석 중에는 큐가 전화를 배정하지 않는다 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TextCaption}" Text="근무 상태" />
                        <TextBlock Margin="0,2,0,0" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                    <Setter Property="Text" Value="이석" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                            <Setter Property="Text" Value="대기" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1" VerticalAlignment="Center" MinWidth="96"
                            Command="{Binding ToggleAvailabilityCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                <Setter Property="Content" Value="대기로" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                        <Setter Property="Content" Value="이석" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 대기 안내 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDialing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="대기 중" Style="{StaticResource TextTitle}" HorizontalAlignment="Center" />
                    <TextBlock Text="전화가 오면 이 창이 바뀐다"
                               Style="{StaticResource TextCaption}"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!--
                    발신 중. PBX 가 이 단말을 먼저 부르는 방식이라 걸고 나서 전화가 올 때까지 시간이 뜬다.
                    그 사이 화면이 "대기 중" 이면 눌린 건지 알 수 없다.
                -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDialing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="발신 중"
                               Style="{StaticResource TextTitle}"
                               Foreground="{StaticResource BrushAccent}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DialingNumber}"
                               FontFamily="{StaticResource FontUi}"
                               FontSize="{StaticResource FontSizeNumber}"
                               Foreground="{StaticResource BrushText}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="전화기가 먼저 울린다. 그대로 두면 자동으로 연결된다"
                               Style="{StaticResource TextCaption}"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 발신 -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="전화 걸기" Style="{StaticResource TextCaption}" Margin="0,0,0,6" />

                    <!--
                        발신번호는 외부로 걸 때만 뜻이 있다. 내선 통화에는 쓰이지 않으므로 접어 둔다.
                        Collapsed 라 자리도 차지하지 않아 창 높이가 흔들리지 않는다.
                    -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsCallerIdPicker}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="발신번호" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding CallerIds}"
                                  SelectedItem="{Binding SelectedCallerId}"
                                  Padding="{StaticResource PadControl}"
                                  FontFamily="{StaticResource FontUi}"
                                  FontSize="{StaticResource FontSizeBody}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- UpdateSourceTrigger=PropertyChanged 라야 한 글자 칠 때마다 버튼이 열린다 -->
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource FieldInput}"
                                 Text="{Binding DialNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="80"
                                Content="걸기"
                                Style="{StaticResource ButtonPrimary}"
                                IsDefault="True"
                                Command="{Binding DialCommand}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 꼬리말: 알림 자리를 고정해 두면 메시지가 떠도 위 영역이 흔들리지 않는다 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Height="20"
                       Text="{Binding NoticeMessage}"
                       Foreground="{StaticResource BrushWarning}"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource TextCaption}" />

            <!-- 교대 근무에서 앞사람 계정으로 앉지 않으려면 나가는 길이 있어야 한다. -->
            <Button Grid.Column="1"
                    Content="로그아웃"
                    Padding="8,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Foreground="{StaticResource BrushTextMuted}"
                    FontFamily="{StaticResource FontUi}"
                    FontSize="{StaticResource FontSizeCaption}"
                    Command="{Binding SignOutCommand}" />
        </Grid>
    </Grid>
</UserControl>
