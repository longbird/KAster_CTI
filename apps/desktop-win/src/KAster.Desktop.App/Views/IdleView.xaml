<UserControl x:Class="KAster.Desktop.App.Views.IdleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="clr-namespace:KAster.Desktop.App.Controls" xmlns:views="clr-namespace:KAster.Desktop.App.Views" Background="{DynamicResource BrushBackground}" Unloaded="OnUnloaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,10,0">
        <icons:AppIcon Kind="Users" Size="19" Foreground="{DynamicResource BrushAccent}" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding AgentName}" ToolTip="{Binding AgentName}" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Extension, StringFormat=내선 {0}}" Style="{StaticResource TextCaption}" FontSize="10" />
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource BarIconButton}" ToolTip="상담원 목록" AutomationProperties.Name="상담원 목록" Command="{Binding Directory.OpenCommand}">
          <icons:AppIcon Kind="Users" Size="20" Foreground="{DynamicResource BrushTextMuted}" />
        </Button>
        <Button Style="{StaticResource BarIconButton}" ToolTip="큐 현황" AutomationProperties.Name="큐 현황" Command="{Binding Queues.OpenCommand}">
          <icons:AppIcon Kind="Queue" Size="20" Foreground="{DynamicResource BrushTextMuted}" />
        </Button>
        <!-- 안 읽은 공지는 점으로 알린다. 44px 막대에 숫자를 넣을 자리가 없다. -->
        <Button Style="{StaticResource BarIconButton}" ToolTip="{Binding Announcements.EntryText}" AutomationProperties.Name="공지" Command="{Binding Announcements.OpenCommand}">
          <Grid>
            <icons:AppIcon Kind="Bell" Size="20" Foreground="{DynamicResource BrushTextMuted}" />
            <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" Fill="{DynamicResource BrushDanger}">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Announcements.HasUnread}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
          </Grid>
        </Button>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Margin="20,0,20,12" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}">
      <Grid Margin="{StaticResource PadPanel}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,6" CornerRadius="20" Background="{DynamicResource BrushAccentSoft}">
            <TextBlock FontSize="12" FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                  <Setter Property="Text" Value="자리비움" />
                  <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                      <Setter Property="Text" Value="상담 대기" />
                      <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <Button Grid.Column="1" Height="32" MinWidth="84" Padding="12,0" FontSize="12" Command="{Binding ToggleAvailabilityCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                <Setter Property="Content" Value="대기로" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                    <Setter Property="Content" Value="자리비움" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
          <Grid>
            <!-- 대기 안내 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Dial.IsDialing}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeskPhone.ShowsDeskPhoneSetup}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <StackPanel Margin="0,12" HorizontalAlignment="Center">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Waiting.HasWaitingCalls}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Border Width="60" Height="60" CornerRadius="21" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,0,14">
                  <icons:AppIcon Kind="Headset" Size="34" Foreground="{DynamicResource BrushAccent}" />
                </Border>
                <TextBlock HorizontalAlignment="Center" FontSize="20">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextTitle}">
                      <Setter Property="Text" Value="잠시 자리를 비웠어요" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                          <Setter Property="Text" Value="전화를 받을 준비가 됐어요" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                          <Setter Property="Text" Value="서버 연결을 확인해 주세요" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="전화가 오면 이곳에서 확인할 수 있습니다." Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,7,0,0" FontSize="11" />
              </StackPanel>
              <!--
                        당겨받기. 옆자리에 울리는 전화를 여기서 끌어온다.
                        받을 수 있는 것이 있을 때만 나타난다 — 늘 떠 있으면 빈 목록이 자리만 차지한다.
                    -->
              <StackPanel Margin="0,14,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Waiting.HasWaitingCalls}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="당겨받을 수 있는 전화" VerticalAlignment="Center" Style="{StaticResource TextCaption}" />
                  <!--
                                한두 건이면 목록이 읽기 좋고, 쌓이면 타일이 한눈에 들어온다.
                                자리마다 선호가 달라 고르게 둔다.
                            -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="목록" Padding="6,1" BorderThickness="0" Cursor="Hand" Background="Transparent" FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeCaption}" Command="{Binding Waiting.SetWaitingLayoutCommand}" CommandParameter="list">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Waiting.ShowsWaitingAsList}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Content="타일" Padding="6,1" BorderThickness="0" Cursor="Hand" Background="Transparent" FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeCaption}" Command="{Binding Waiting.SetWaitingLayoutCommand}" CommandParameter="tile">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Waiting.ShowsWaitingAsTile}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </Grid>
                <!-- 목록: 한 줄에 하나. 고객명과 큐를 함께 읽는다. -->
                <ItemsControl ItemsSource="{Binding Waiting.WaitingCalls}">
                  <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Waiting.ShowsWaitingAsList}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ItemsControl.Style>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Margin="0,0,0,4" HorizontalContentAlignment="Left" Style="{StaticResource ButtonSecondary}" Command="{Binding DataContext.Waiting.PickupCommand,                                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 타일: 한 줄에 둘. 번호 위주로 여러 건을 한눈에 본다. -->
                <ItemsControl ItemsSource="{Binding Waiting.WaitingCalls}">
                  <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Waiting.ShowsWaitingAsTile}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ItemsControl.Style>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Margin="0,0,4,4" HorizontalContentAlignment="Center" Style="{StaticResource ButtonSecondary}" Command="{Binding DataContext.Waiting.PickupCommand,                                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <TextBlock Text="{Binding PhoneNumber}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 자리에 못 들어간 건수는 숨기지 않고 숫자로 알린다. -->
                <TextBlock Text="{Binding Waiting.WaitingCallsHiddenText}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <!--
                    실기기 등록 안내. 전화기가 등록돼 있지 않으면 전화를 한 통도 못 받으므로,
                    그 자리에서 필요한 것은 "대기 중" 안내가 아니라 전화기에 넣을 값이다.
                    값은 읽기 전용 TextBox 라 상담원이 끌어서 복사할 수 있다.
                -->
            <StackPanel VerticalAlignment="Center">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DeskPhone.ShowsDeskPhoneSetup}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="전화기에 아래 값을 넣으세요" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
              <Grid Margin="0,2,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 스스로도 몇 초마다 확인하지만, 기다리지 않고 바로 보고 싶을 때가 있다. -->
                <Button Grid.Column="1" Content="다시 확인" Padding="6,0" BorderThickness="0" Background="Transparent" Cursor="Hand" Foreground="{DynamicResource BrushAccent}" FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeCaption}" Command="{Binding DeskPhone.RecheckDeskPhoneCommand}" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="서버" Style="{StaticResource TextCaption}" Margin="0,0,10,5" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeskPhone.SipServerAddress, Mode=OneWay}" Style="{StaticResource FieldReadOnly}" Margin="0,0,0,5" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="계정" Style="{StaticResource TextCaption}" Margin="0,0,10,5" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeskPhone.SipUsername, Mode=OneWay}" Style="{StaticResource FieldReadOnly}" Margin="0,0,0,5" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="도메인" Style="{StaticResource TextCaption}" Margin="0,0,10,5" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DeskPhone.SipDomain, Mode=OneWay}" Style="{StaticResource FieldReadOnly}" Margin="0,0,0,5" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="전송" Style="{StaticResource TextCaption}" Margin="0,0,10,5" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DeskPhone.SipTransport, Mode=OneWay}" Style="{StaticResource FieldReadOnly}" Margin="0,0,0,5" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="비밀번호" Style="{StaticResource TextCaption}" Margin="0,0,10,0" />
                <Grid Grid.Row="4" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <!-- 자리 화면은 지나가는 사람에게 그대로 보인다. 넣을 때만 펼친다. -->
                  <TextBox Grid.Column="0" Text="{Binding DeskPhone.SipPasswordDisplay, Mode=OneWay}" Style="{StaticResource FieldReadOnly}" />
                  <Button Grid.Column="1" Padding="6,0" BorderThickness="0" Background="Transparent" Cursor="Hand" Foreground="{DynamicResource BrushAccent}" FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeCaption}" Command="{Binding DeskPhone.ToggleSipPasswordCommand}">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Content" Value="보기" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DeskPhone.IsSipPasswordVisible}" Value="True">
                            <Setter Property="Content" Value="가리기" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>
              </Grid>
            </StackPanel>
            <!--
                    발신 중. PBX 가 이 단말을 먼저 부르는 방식이라 걸고 나서 전화가 올 때까지 시간이 뜬다.
                    그 사이 화면이 "대기 중" 이면 눌린 건지 알 수 없다.
                -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Dial.IsDialing}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="발신 중" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Dial.DialingNumber}" FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeNumber}" Foreground="{DynamicResource BrushText}" Margin="0,4,0,0" HorizontalAlignment="Center" />
              <TextBlock Text="전화기를 받으면 연결됩니다" Style="{StaticResource TextCaption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <!-- 발신: 번호 입력은 목록 스크롤과 분리한다. -->
        <StackPanel Grid.Row="2">
          <TextBlock Text="전화 걸기" Style="{StaticResource TextCaption}" Margin="0,0,0,6" />
          <!--
                        발신번호는 외부로 걸 때만 뜻이 있다. 내선 통화에는 쓰이지 않으므로 접어 둔다.
                        Collapsed 라 자리도 차지하지 않아 창 높이가 흔들리지 않는다.
                    -->
          <StackPanel Margin="0,0,0,8">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Dial.ShowsCallerIdPicker}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="발신번호" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Dial.CallerIds}" SelectedItem="{Binding Dial.SelectedCallerId}" Padding="{StaticResource PadControl}" FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeBody}" />
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- UpdateSourceTrigger=PropertyChanged 라야 한 글자 칠 때마다 버튼이 열린다 -->
            <Grid Grid.Column="0">
              <TextBox x:Name="DialNumberField" AutomationProperties.Name="전화번호 또는 내선" Style="{StaticResource FieldInput}" Text="{Binding Dial.DialNumber, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="전화번호 또는 내선" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=DialNumberField}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="OpenDialPadButton" Margin="6,0,0,0" Width="38" Padding="0" Style="{StaticResource ButtonSecondary}"
                    ToolTip="발신 키패드" AutomationProperties.Name="발신 키패드" Click="OnOpenDialPad">
              <icons:AppIcon Kind="Keypad" Size="20" />
            </Button>
            <Button Margin="6,0,0,0" MinWidth="72" Padding="10,0" Style="{StaticResource ButtonPrimary}" IsDefault="True" Command="{Binding Dial.DialCommand}" Click="OnCloseDialPad">
              <StackPanel Orientation="Horizontal">
                <icons:AppIcon Kind="Phone" Size="17" Margin="0,0,7,0" />
                <TextBlock Text="걸기" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            </StackPanel>
            <Popup x:Name="DialPadPopup" PlacementTarget="{Binding ElementName=DialNumberField}" Placement="Top"
                   VerticalOffset="-8" StaysOpen="False" AllowsTransparency="True" Opened="OnDialPadOpened" Closed="OnDialPadClosed">
              <views:DialPadView x:Name="DialPad" Width="264" Target="{Binding ElementName=DialNumberField}"
                                 CloseRequested="OnCloseDialPad" />
            </Popup>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Margin="20,0,20,12">
      <UniformGrid Columns="3" Margin="0,0,0,8">
        <Button Style="{StaticResource ButtonSecondary}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="3,0" Height="40" FontSize="12" Padding="6,0" Command="{Binding History.OpenHistoryCommand}">
          <StackPanel Orientation="Horizontal">
            <icons:AppIcon Kind="History" Size="16" Margin="0,0,6,0" />
            <TextBlock Text="지난 통화" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ButtonSecondary}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="3,0" Height="40" FontSize="12" Padding="6,0" Command="{Binding OpenSettingsCommand}">
          <StackPanel Orientation="Horizontal">
            <icons:AppIcon Kind="Settings" Size="16" Margin="0,0,6,0" />
            <TextBlock Text="설정" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ButtonSecondary}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="3,0" Height="40" FontSize="12" Padding="6,0" Command="{Binding SignOutCommand}">
          <StackPanel Orientation="Horizontal">
            <icons:AppIcon Kind="Logout" Size="16" Margin="0,0,6,0" />
            <TextBlock Text="로그아웃" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </UniformGrid>
      <TextBlock Text="필수 업데이트가 있습니다. 설정에서 설치 파일을 받아 설치해야 새 통화를 시작할 수 있습니다."
                 TextWrapping="Wrap" Foreground="{DynamicResource BrushDanger}" Margin="0,4,0,4">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding RequiresUpdate}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Grid Height="22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding NoticeMessage}" ToolTip="{Binding NoticeMessage}" Foreground="{DynamicResource BrushWarning}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="업데이트 있음" Padding="8,0" Background="Transparent" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Command="{Binding OpenUpdateCommand}">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Visibility" Value="Collapsed" />
              <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Update.HasUpdate}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- 필수는 눈에 더 걸려야 한다. 그래도 앱을 끄지는 않는다. -->
                <DataTrigger Binding="{Binding Update.IsRequired}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <Ellipse Width="6" Height="6" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource BrushDanger}" />
                <Setter Property="ToolTip" Value="서버 끊김" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
                    <Setter Property="ToolTip" Value="서버 연결됨" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                <Setter Property="Text" Value="서버 연결 끊김" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Text" Value="서버 연결됨" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Border Width="1" Height="12" Margin="9,0" VerticalAlignment="Center" Background="{DynamicResource BrushBorder}" />
          <Ellipse Width="6" Height="6" VerticalAlignment="Center" ToolTip="{Binding DeskPhone.PhoneStatusText}">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource BrushDanger}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DeskPhone.IsPhoneRegistered}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding DeskPhone.PhoneStatusText}" FontSize="10" MaxWidth="190" Style="{StaticResource TextCaption}" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="{Binding DeskPhone.PhoneStatusText}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
