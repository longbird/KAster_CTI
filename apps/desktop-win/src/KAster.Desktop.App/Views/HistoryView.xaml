<UserControl x:Class="KAster.Desktop.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <!--
        지난 통화. 읽는 것은 넷이다 — 언제, 어느 번호와, 얼마나, 받았는지.
        줄을 누르면 그 번호가 발신 칸에 들어간다. 번호를 옮겨 적게 하지 않는다.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="지난 통화" Style="{StaticResource TextCaption}" />

        <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding History.Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,0,0,4"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding DataContext.History.CallBackCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 버튼 스타일의 가운데 정렬이 내려오면 번호가 가운데로 몰린다. -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding PhoneNumber}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Left"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WasMissed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding When}"
                                           HorizontalAlignment="Left"
                                           Style="{StaticResource TextCaption}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Duration}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource TextCaption}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="2" Margin="0,10,0,0" Content="닫기"
                Style="{StaticResource ButtonSecondary}"
                Command="{Binding History.CloseHistoryCommand}" />
    </Grid>
</UserControl>
