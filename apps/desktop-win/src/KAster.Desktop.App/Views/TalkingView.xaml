<UserControl x:Class="KAster.Desktop.App.Views.TalkingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 남는 세로 공간은 이 한 곳만 흡수한다. 여러 곳이 늘어나면 합계가 창을 넘긴다. -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            상대. 번호가 제목 자리에 온다 — 고객명은 모르는 경우가 더 많고, 상담원이 통화 중에
            눈으로 읽고 받아 적는 것은 번호다. 이름은 있을 때만 아래에 붙는다.
        -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding CalledLine}"
                       Style="{StaticResource TextCaption}"
                       Foreground="{StaticResource BrushAccent}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Text="{Binding PhoneNumber}" Style="{StaticResource TextTitle}" Margin="0,2,0,0" />

            <TextBlock Text="{Binding CustomerName}"
                       Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CustomerName}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- 통화 시간 -->
        <TextBlock Grid.Row="1"
                   Text="{Binding CallDurationText}"
                   Style="{StaticResource TextBody}"
                   FontSize="{StaticResource FontSizeNumber}"
                   FontWeight="SemiBold"
                   Margin="0,12,0,0" />

        <!-- 메모: 고정 줄 수까지만 보인다. 길어져도 창이 스크롤되지 않는다. -->
        <Border Grid.Row="2" Margin="0,12"
                Padding="{StaticResource PadPanel}"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="메모" Style="{StaticResource TextCaption}" />
                <!-- 통화가 끝날 때 저장된다. 바인딩이 없으면 적은 내용이 화면 전환과 함께 사라진다. -->
                <TextBox Grid.Row="1" Margin="0,6,0,0"
                         Style="{StaticResource FieldInput}"
                         Height="Auto"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Disabled"
                         MaxLines="5"
                         Text="{Binding MemoText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!-- 조작 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding ToggleMuteCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                        <Setter Property="Content" Value="마이크 끄기" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter Property="Content" Value="마이크 켜기" />
                                <Setter Property="Background" Value="{StaticResource BrushWarning}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextOnAccent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" Content="끊기"
                    Style="{StaticResource ButtonDanger}"
                    Command="{Binding HangupCommand}" />
        </Grid>

        <TextBlock Grid.Row="4" Height="20" Margin="0,8,0,0"
                   Text="{Binding NoticeMessage}"
                   Foreground="{StaticResource BrushWarning}"
                   Style="{StaticResource TextCaption}" />
    </Grid>
</UserControl>
