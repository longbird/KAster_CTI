<UserControl x:Class="KAster.Desktop.App.Views.QueueStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">

    <!--
        큐 대기 현황. 값은 REST 조회 한 갈래에서만 오고, 창이 떠 있는 동안에만 갱신된다.
        큐가 많아도 창이 늘어나면 안 되므로 보여 주는 수를 고정하고 가린 수를 숫자로 알린다.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="큐" Style="{StaticResource TextCaption}" />
            <TextBlock Grid.Column="2" Text="대기" MinWidth="44"
                       TextAlignment="Right" Style="{StaticResource TextCaption}" />
            <TextBlock Grid.Column="3" Text="통화" MinWidth="44"
                       TextAlignment="Right" Style="{StaticResource TextCaption}" />
            <TextBlock Grid.Column="4" Text="대기중 상담원" MinWidth="80"
                       TextAlignment="Right" Style="{StaticResource TextCaption}" />
        </Grid>

        <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Queues.Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="10,8"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding QueueName}"
                                           Style="{StaticResource TextBody}"
                                           FontWeight="SemiBold" />

                                <!--
                                    가장 오래 기다린 시간. 대기가 없으면 빈 문자열이라 이 줄이 접힌다 —
                                    지난 값을 남겨 두면 아무도 안 기다리는 큐가 기다리는 것처럼 보인다.
                                -->
                                <TextBlock Text="{Binding LongestWaitText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                            <Style.Triggers>
                                                <!-- 임계값을 넘긴 큐. 창을 여는 이유가 대개 이것 하나다. -->
                                                <DataTrigger Binding="{Binding IsOverThreshold}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Waiting}"
                                       MinWidth="44" TextAlignment="Right"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverThreshold}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="2" Text="{Binding Talking}"
                                       MinWidth="44" TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TextBody}" />

                            <!--
                                받을 수 있는 사람이 0 인데 대기가 쌓이면 그 큐는 스스로 풀리지 않는다.
                                숫자만 두면 그 사실이 눈에 안 들어온다.
                            -->
                            <TextBlock Grid.Column="3" Text="{Binding Available}"
                                       MinWidth="80" TextAlignment="Right"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNobodyToAnswer}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 큐가 없다는 것과 아직 못 받아 왔다는 것은 다르다. 둘 다 빈 화면이면 구분이 안 된다. -->
        <TextBlock Grid.Row="1" Margin="0,8,0,0"
                   Text="표시할 큐가 없습니다."
                   VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Queues.HasRows}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="2" Margin="0,2,0,0"
                   Text="{Binding Queues.RowsHiddenText}"
                   Style="{StaticResource TextCaption}" />

        <Button Grid.Row="3" Margin="0,10,0,0" Content="닫기"
                Style="{StaticResource ButtonSecondary}"
                Command="{Binding Queues.CloseCommand}" />
    </Grid>
</UserControl>
