<UserControl x:Class="KAster.Desktop.App.Views.CustomerInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <!--
        지금 통화 중인 고객. 서버에 물어보지 않는다 — 상담원 역할은 고객 조회가 403 이다.
        여기 있는 것은 스크린팝이 실어 보낸 것뿐이고, 안 온 칸은 아예 접는다.
        없는 칸을 "-" 로 채우면 없는 정보를 있는 것처럼 읽게 된다.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Customer.HasCustomerInfo}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- 고객이 건 지사. 인사말과 안내가 지사마다 다르다. -->
            <TextBlock Text="{Binding Customer.BranchName}"
                       Foreground="{StaticResource BrushAccent}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Customer.HasBranchName}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding Customer.PhoneNumber}"
                       Style="{StaticResource TextTitle}"
                       Margin="0,2,0,0" />

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 고객명은 서버가 모르는 경우가 더 많다. 없으면 자리를 비운다. -->
                <TextBlock Grid.Column="0" Text="{Binding Customer.CustomerName}"
                           Style="{StaticResource TextBody}"
                           FontWeight="SemiBold" />

                <!-- 보통 등급은 띄우지 않는다. 등급이 뜻을 가지는 것은 보통과 다를 때뿐이다. -->
                <Border Grid.Column="1" Padding="8,2"
                        CornerRadius="{StaticResource RadiusChip}"
                        Background="{StaticResource BrushWarning}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Customer.HasGrade}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding Customer.Grade}"
                               Style="{StaticResource TextCaption}"
                               Foreground="{StaticResource BrushTextOnAccent}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <TextBlock Text="{Binding Customer.CompanyName}" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Customer.HasCompanyName}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- 메모. 남는 세로 자리를 이 한 곳만 흡수한다. -->
        <Border Grid.Row="1" Margin="0,12,0,0"
                Padding="{StaticResource PadPanel}"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Customer.HasMemo}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="고객 메모" Style="{StaticResource TextCaption}" />
                <TextBlock Text="{Binding Customer.Memo}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource TextBody}" />
            </StackPanel>
        </Border>

        <!--
            스크린팝이 안 오는 통화가 있다. 빈 창을 띄우면 상담원은 조회가 실패한 줄 알고 기다린다 —
            열 것 자체가 없다는 것이 사실이다.
        -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Customer.EmptyText}"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Customer.HasCustomerInfo}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Button Grid.Row="2" Margin="0,10,0,0" Content="닫기"
                Style="{StaticResource ButtonSecondary}"
                Command="{Binding Customer.CloseCommand}" />
    </Grid>
</UserControl>
