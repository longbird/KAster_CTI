<UserControl x:Class="KAster.Desktop.App.Views.RingingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            발신은 PBX 가 이 단말을 먼저 부르는 방식이라 수신 INVITE 로 들어온다.
            그걸 "수신 전화" 라고 띄우면 방금 자기가 건 전화를 받아야 하는 줄 알고 멈칫한다.
        -->
        <TextBlock Grid.Row="0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                    <Setter Property="Text" Value="수신 전화" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOutboundCall}" Value="True">
                            <Setter Property="Text" Value="발신 중 — 전화기를 받으면 연결됩니다" />
                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 고객 정보. 이름과 번호 모두 한 줄 + 말줄임이라 긴 이름이 와도 창이 늘어나지 않는다. -->
        <Border Grid.Row="1" Margin="0,8,0,12"
                Padding="{StaticResource PadPanel}"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding CustomerName}"
                           Style="{StaticResource TextTitle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PhoneNumber}"
                           Style="{StaticResource TextBody}"
                           FontSize="{StaticResource FontSizeNumber}"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding HangupCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
                        <Setter Property="Content" Value="거절" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutboundCall}" Value="True">
                                <Setter Property="Content" Value="취소" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 내가 건 전화에는 받을 것이 없다. 커맨드도 닫혀 있지만 버튼 자체를 감춘다. -->
            <Button Grid.Column="2" Content="받기"
                    Command="{Binding AnswerCommand}"
                    IsDefault="True">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutboundCall}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
