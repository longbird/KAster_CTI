<UserControl x:Class="KAster.Desktop.App.Views.RingingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="수신 전화" Style="{StaticResource TextCaption}" />

        <!-- 고객 정보. 이름과 번호 모두 한 줄 + 말줄임이라 긴 이름이 와도 창이 늘어나지 않는다. -->
        <Border Grid.Row="1" Margin="0,8,0,12"
                Padding="{StaticResource PadPanel}"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding CustomerName}"
                           Style="{StaticResource TextTitle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PhoneNumber}"
                           Style="{StaticResource TextBody}"
                           FontSize="{StaticResource FontSizeNumber}"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="거절"
                    Style="{StaticResource ButtonDanger}"
                    Command="{Binding HangupCommand}" />
            <Button Grid.Column="2" Content="받기"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding AnswerCommand}"
                    IsDefault="True" />
        </Grid>
    </Grid>
</UserControl>
