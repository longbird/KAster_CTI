<Window x:Class="KAster.Desktop.App.Views.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBX 상담원" Width="430" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushText}">
  <StackPanel Margin="24">
    <TextBlock Text="앱을 어떻게 닫을까요?" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="트레이로 숨기면 상담 상태를 유지하며, 전화가 올 때 알림을 받을 수 있습니다."
               TextWrapping="Wrap" Margin="0,12,0,20" />
    <Button Content="트레이로 숨기기" Style="{StaticResource ButtonPrimary}" Height="42"
            IsDefault="True" Click="HideClicked" />
    <Button Content="앱 종료" Style="{StaticResource ButtonSecondary}" Height="42"
            Margin="0,10,0,0" Click="QuitClicked" />
    <TextBlock Text="앱을 종료하면 전화 알림을 받을 수 없으며, 진행 중인 소프트폰 통화가 끊어질 수 있습니다."
               TextWrapping="Wrap" FontSize="12" Margin="0,12,0,12" />
    <Button Content="취소" IsCancel="True" Style="{StaticResource ButtonSecondary}" Height="34" />
  </StackPanel>
</Window>
