<Window x:Class="KAster.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBX 상담원"
        Width="440" Height="560"
        MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontUi}"
        Background="{DynamicResource BrushBackground}"
        Foreground="{DynamicResource BrushText}"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- 창 전체가 스크롤되는 컨테이너를 두지 않는다. 각 화면이 자기 창 크기 안에서 끝낸다. -->
    <ContentControl x:Name="Host" />
</Window>
