@@ -67,8 +67,109 @@ fi
 export COMPOSE_FILE
 export ENV_PATH
 
+read_env_value() {
+  local key="$1"
+  awk -F= -v key="$key" '
+    $1 == key {
+      sub(/^[^=]*=/, "")
+      gsub(/\r$/, "")
+      print
+      exit
+    }
+  ' "$ENV_PATH"
+}
+
+attach_external_asterisk_network() {
+  local network
+  network="$(read_env_value ASTERISK_DOCKER_NETWORK)"
+  if [[ -z "$network" ]]; then
+    return 0
+  fi
+
+  if ! docker network inspect "$network" >/dev/null 2>&1; then
+    echo "Configured ASTERISK_DOCKER_NETWORK does not exist: $network" >&2
+    exit 66
+  fi
+
+  local server_container
+  server_container="$(docker compose -f "$COMPOSE_FILE" --env-file "$ENV_PATH" ps -q server)"
+  if [[ -z "$server_container" ]]; then
+    echo "Unable to resolve server container for external network attachment." >&2
+    exit 66
+  fi
+
+  if docker inspect "$server_container" --format '{{json .NetworkSettings.Networks}}' | grep -q "\"$network\""; then
+    echo "Server is already attached to external Asterisk network: $network"
+    return 0
+  fi
+
+  echo "Attaching server to external Asterisk network: $network"
+  docker network connect "$network" "$server_container"
+  echo "Restarting server after external Asterisk network attachment"
+  docker compose -f "$COMPOSE_FILE" --env-file "$ENV_PATH" restart server
+}
+
+is_truthy_env() {
+  case "${1,,}" in
+    1|true|yes|on) return 0 ;;
+    *) return 1 ;;
+  esac
+}
+
+preflight_asterisk_conf_mount() {
+  local allow_shared
+  allow_shared="$(read_env_value ASTERISK_CONF_ALLOW_SHARED_WRITE)"
+  if is_truthy_env "$allow_shared"; then
+    echo "Asterisk conf shared-write preflight skipped by ASTERISK_CONF_ALLOW_SHARED_WRITE=$allow_shared"
+    return 0
+  fi
+
+  local conf_dir
+  conf_dir="$(read_env_value ASTERISK_CONF_DIR)"
+  if [[ -z "$conf_dir" ]]; then
+    conf_dir="/etc/asterisk"
+  fi
+
+  if [[ "$conf_dir" != /* ]]; then
+    echo "ASTERISK_CONF_DIR must be an absolute host path: $conf_dir" >&2
+    exit 67
+  fi
+
+  local conf_source
+  conf_source="$(realpath -m "$conf_dir")"
+  local site_code
+  site_code="$(read_env_value SITE_CODE)"
+  local expected_name="kaster-${site_code}-server"
+  local conflicts=()
+
+  while IFS= read -r container_id; do
+    [[ -z "$container_id" ]] && continue
+    local name
+    name="$(docker inspect "$container_id" --format '{{.Name}}' | sed 's#^/##')"
+    [[ "$name" == "$expected_name" ]] && continue
+    [[ "$name" =~ ^kaster.*server$ ]] || continue
+
+    local mount_sources
+    mount_sources="$(docker inspect "$container_id" --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}')"
+    while IFS= read -r source; do
+      [[ -z "$source" ]] && continue
+      if [[ "$(realpath -m "$source")" == "$conf_source" ]]; then
+        conflicts+=("$name mounts $conf_source")
+      fi
+    done <<< "$mount_sources"
+  done < <(docker ps -q)
+
+  if [[ "${#conflicts[@]}" -gt 0 ]]; then
+    echo "Refusing deployment: another KAster server container is already mounted on ASTERISK_CONF_DIR=$conf_source" >&2
+    printf '  - %s\n' "${conflicts[@]}" >&2
+    echo "Stop the other writer, use a site-unique ASTERISK_CONF_DIR, or set ASTERISK_CONF_ALLOW_SHARED_WRITE=true only for an intentional shared-writer deployment." >&2
+    exit 67
+  fi
+}
+
 echo "==> Validating compose config"
 docker compose -f "$COMPOSE_FILE" --env-file "$ENV_PATH" config >/dev/null
+preflight_asterisk_conf_mount
 
 if [[ "$SKIP_BACKUP" -eq 0 ]]; then
   BACKUP_DIR="$SITE_DIR/backups"
