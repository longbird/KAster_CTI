+  grid-template-columns: repeat(5, minmax(96px, 1fr));
+  overflow: hidden;
+  background: var(--bg-1);
+  border: 1px solid var(--line-1);
+  border-radius: var(--r-md);
+}
+.dashboard-compact__kpi-cell {
+  min-width: 0;
+  padding: 10px 12px;
+  border-right: 1px solid var(--line-1);
+}
+.dashboard-compact__kpi-cell:last-child { border-right: 0; }
+.dashboard-compact__kpi-cell .label {
+  color: var(--fg-3);
+  font-size: 11px;
+  font-weight: 600;
+  line-height: 1.25;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.dashboard-compact__kpi-cell .value {
+  margin-top: 4px;
+  color: var(--fg-1);
+  font-family: var(--font-mono);
+  font-size: 22px;
+  font-weight: 700;
+  line-height: 1;
+  font-variant-numeric: tabular-nums;
+}
+.dashboard-compact__kpi-cell .delta {
+  min-height: 14px;
+  margin-top: 3px;
+  font-size: 10px;
+  line-height: 1.2;
+}
+
+.active-calls-kanban {
+  height: 100%;
+  min-height: 0;
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: 8px;
+}
+.call-kanban-column {
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  border: 1px solid var(--line-1);
+  border-radius: var(--r-md);
+  background: var(--bg-0);
+}
+.call-kanban-column__header {
+  min-height: 34px;
+  padding: 8px 10px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  border-top: 3px solid var(--line-3);
+  border-bottom: 1px solid var(--line-1);
+  background: var(--bg-2);
+}
+.call-kanban-column__label {
+  min-width: 0;
+  color: var(--fg-1);
+  font-size: 12px;
+  font-weight: 700;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.call-kanban-column__count {
+  min-width: 22px;
+  height: 18px;
+  padding: 0 6px;
+  border-radius: 999px;
+  background: var(--bg-3);
+  color: var(--fg-2);
+  font-family: var(--font-mono);
+  font-size: 11px;
+  line-height: 18px;
+  text-align: center;
+}
+.call-kanban-column__body {
+  min-height: 0;
+  flex: 1;
+  padding: 8px;
+  overflow: auto;
+}
+.call-kanban-column__empty {
+  display: block;
+  font-size: 11px;
+  line-height: 1.35;
+}
+.call-card {
+  min-width: 0;
+  padding: 8px;
+  border: 1px solid var(--line-1);
+  border-radius: var(--r-sm);
+  background: var(--bg-1);
+  cursor: pointer;
+}
+.call-card + .call-card { margin-top: 6px; }
+.call-card__row {
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+}
+.call-card__ani,
+.call-card__elapsed,
+.call-card__sub,
+.call-card__did {
+  min-width: 0;
+  font-size: 11px;
+}
+.call-card__ani {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.call-card__elapsed {
+  flex: 0 0 auto;
+  font-family: var(--font-mono);
+  color: var(--fg-2);
+  font-variant-numeric: tabular-nums;
+}
+.call-card__sub,
+.call-card__did {
+  display: block;
+  margin-top: 3px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.queue-summary-table__queue-name {
+  display: block;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.call-log-table .ant-table-tbody > tr > td {
+  padding-top: 8px !important;
+  padding-bottom: 8px !important;
+  vertical-align: middle;
+}
+.call-flow-cell {
+  display: flex;
+  min-width: 0;
+  max-width: 100%;
+  flex-direction: column;
+  gap: 2px;
+}
+.call-flow-summary,
+.call-flow-linkedid {
+  display: block;
+  max-width: 100%;
+}
+.call-flow-summary {
+  color: var(--fg-1);
+  line-height: 18px;
+}
+.call-flow-linkedid {
+  color: var(--fg-3) !important;
+  font-family: var(--font-mono);
+  font-size: 11px;
+  line-height: 16px;
+}
+
+@media (max-width: 1180px) {
+  .dashboard-compact {
+    grid-template-columns: 1fr;
+    grid-template-areas:
+      "header"
+      "kpi"
+      "alerts"
+      "calls"
+      "bottom";
+  }
+  .dashboard-compact__bottom { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 900px) {
+  .dashboard-compact__kpi-strip,
+  .active-calls-kanban {
+    grid-template-columns: 1fr;
+  }
+}
 
 /* Traffic chart */
 .traffic-chart { display: flex; flex-direction: column; gap: 12px; }
