+function hasUnresolvedTemplatePlaceholder(content: string, allowAsteriskRuntimeExpressions = false): boolean {
+  if (!content.includes('${')) return false;
+  if (!allowAsteriskRuntimeExpressions) return true;
+
+  return findDollarBraceExpressions(content).some((expression) => !isAsteriskRuntimeExpression(expression));
+}
+
+function findDollarBraceExpressions(content: string): string[] {
+  const expressions: string[] = [];
+  let index = 0;
+
+  while (index < content.length) {
+    const start = content.indexOf('${', index);
+    if (start < 0) break;
+
+    let cursor = start + 2;
+    let depth = 1;
+    while (cursor < content.length && depth > 0) {
+      if (content[cursor] === '\r' || content[cursor] === '\n') break;
+      if (content.startsWith('${', cursor)) {
+        depth += 1;
+        cursor += 2;
+        continue;
+      }
+      if (content[cursor] === '}') {
+        depth -= 1;
+      }
+      cursor += 1;
+    }
+
+    if (depth === 0) {
+      expressions.push(content.slice(start, cursor));
+      index = cursor;
+    } else {
+      expressions.push(content.slice(start, cursor));
+      index = cursor + 1;
+    }
+  }
+
+  return expressions;
+}
+
+function isAsteriskRuntimeExpression(expression: string): boolean {
+  const body = expression.slice(2, -1).trim();
+  if (!body) return false;
+
+  return /^[A-Z_][A-Za-z0-9_,:./@+\-^| %"'()[\]${}=!<>}?$]*$/.test(body);
+}
