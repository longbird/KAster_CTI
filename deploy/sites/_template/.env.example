SITE_CODE=sample-site
SITE_DOMAIN=cti.example.com
ADMIN_DOMAIN=admin.cti.example.com
API_DOMAIN=api.cti.example.com
HTTP_PORT=80

POSTGRES_DB=kaster_cti
POSTGRES_USER=kaster
POSTGRES_PASSWORD=change_me

JWT_SECRET=replace_with_long_random_secret

AMI_HOST=10.0.0.10
AMI_PORT=5038
AMI_USERNAME=cti_middleware
AMI_SECRET=replace_with_real_ami_secret
AMI_RECONNECT_MS=5000

ASTERISK_NODE_ID=sample-site-asterisk-a
ASTERISK_OUTBOUND_CONTEXT=outbound-main
ASTERISK_ATXFER_COMPLETE_CODE=*2
ASTERISK_HOLD_FEATURE_CODE=
ASTERISK_RESUME_FEATURE_CODE=
ASTERISK_CONF_DIR=/etc/asterisk

# 상담원 데스크톱 설치 파일을 놓을 호스트 경로. 서버 컨테이너가 읽기 전용으로 마운트한다.
AGENT_ARTIFACT_DIR=./agent-artifacts

REST_CORS_ORIGIN=https://cti.example.com,https://admin.cti.example.com
WS_CORS_ORIGIN=https://cti.example.com,https://admin.cti.example.com

VITE_API_BASE_URL=https://api.cti.example.com/api/v1
VITE_WS_URL=https://api.cti.example.com
VITE_USE_MOCK=false
VITE_ACCESS_TOKEN_KEY=kaster.access_token
